# Copy this file to `.env` and fill in the real values before running
# `docker compose up`. Every variable here maps directly to a field in
# backend/app/core/config.py's Settings class — if you add a new
# setting there, add its line here too, or the next person to clone
# this repo won't know it exists.
#
# NEVER commit the real `.env` file. Only this `.env.example` (with
# placeholder values) belongs in git.

# --- core -----------------------------------------------------------
# "local" enables SQL query logging and auto-creates DB tables on
# boot (see backend/app/main.py's lifespan). Use "production" once
# you're running real Alembic migrations instead.
ENVIRONMENT=local

# Comma-separated list is fine here even though config.py types this
# as a list — pydantic-settings parses a JSON array string from the
# env; if you hit a parsing error, use: CORS_ORIGINS=["http://localhost:5173"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:8081"]

# --- database ---------------------------------------------------------
# docker-compose.yml overrides this to point at the `db` container
# hostname automatically — this value only matters if you run the
# backend OUTSIDE Docker, straight on your machine.
DATABASE_URL=postgresql+asyncpg://terrashift:terrashift@localhost:5432/terrashift

# --- NASA / Earth observation data -------------------------------------
# From https://urs.earthdata.nasa.gov/ (create a free account, then
# generate a token under "Generate Token").
NASA_EARTHDATA_TOKEN=replace-with-your-earthdata-token

# The full service-account JSON key from Google Earth Engine, as ONE
# LINE (no real newlines). Get it from:
# https://developers.google.com/earth-engine/guides/service_account
# Tip: `python -c "import json; print(json.dumps(json.load(open('key.json'))))"`
# turns a downloaded key file into the single-line form this expects.
GEE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"replace@example.iam.gserviceaccount.com", "...":"..."}

# --- SMS / USSD gateway (only needed to test the SMS channel) -----------
# From the Twilio console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=replace-with-your-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567

# --- ML-backed scoring (optional) -------------------------------------
# Off by default. Only flip to true after running ml-models/*.py to
# actually produce the .joblib files docker-compose.yml mounts in.
USE_ML_SCORER=false
# Matches docker-compose.yml's volume mount for the backend container.
# If you run the backend directly on your machine (not via Compose),
# change this to a relative/absolute path to your own
# ml-models/saved_models folder instead.
ML_MODEL_DIR=/app/ml_models

# --- copilot / RAG -------------------------------------------------
# Defaults run a fully local model via the `ollama` service in
# docker-compose.yml — no key needed, and it works with no internet
# connection, which matters more than convenience during a live demo.
LLM_PROVIDER=ollama
LLM_MODEL_NAME=llama3
OLLAMA_BASE_URL=http://localhost:11434

